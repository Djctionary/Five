# Neon connection string. On Vercel this is injected by the Neon integration.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Registration invite code. Verified server-side only.
INVITE_CODE=222553

# The single timezone the group shares. IANA name.
APP_TIMEZONE=Asia/Shanghai

# Optional. When set, GET /api/init?token=<this> creates the tables.
# Leave it unset once the tables exist and the route stops working.
MIGRATE_TOKEN=
